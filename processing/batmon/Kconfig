menuconfig ROCKETALT_PROCESSING_BATMON
	bool "Battery monitor"
	default n
	---help---
		Enables the program that monitors a battery connected to a voltage
		topic.

if ROCKETALT_PROCESSING_BATMON

config ROCKETALT_BATMON_QLEN
	int "Battery measurement queue length"
	default 5
	---help---
		The length of the queue to use for buffering battery measurements.

comment "Battery options"

choice
	prompt "Battery chemistry"
	default ROCKETALT_BATMON_CHEM_UNK
	
config ROCKETALT_BATMON_CHEM_UNK
	bool "Unknown"
	---help---
		The battery chemistry is unknown (can also use this option if chemistry
		is not listed as a supported option).

config ROCKETALT_BATMON_CHEM_LIPO
	bool "LiPo"
	---help---
		Assume the connected battery is a lithium polymer battery.

config ROCKETALT_BATMON_CHEM_LIION
	bool "Li-Ion"
	---help---
		Assume the connected battery is a lithium ion battery.

endchoice # Battery chemistry

if ROCKETALT_BATMON_CHEM_UNK

config ROCKETALT_BATMON_BATMAX
	int "Battery max voltage (mV)"
	---help---
		The battery's maximum voltage in millivolts.

endif # ROCKETALT_BATMON_CHEM_UNK

endif # ROCKETALT_PROCESSING_BATMON
